FROM python:3.11-slim

# Set environment variables for Python
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Install dependencies
COPY phase3_ui_api/requirements_ui.txt .
RUN pip install --no-cache-dir -r requirements_ui.txt

# Copy Streamlit frontend module and timeseries data
COPY phase3_ui_api/ ./phase3_ui_api/
COPY timeseries_engine/ ./timeseries_engine/

# Expose Streamlit port
EXPOSE 8501

# Run Streamlit dashboard
CMD ["streamlit", "run", "phase3_ui_api/dashboard.py", "--server.port=8501", "--server.address=0.0.0.0"]
