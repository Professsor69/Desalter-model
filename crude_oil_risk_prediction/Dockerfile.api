FROM python:3.10-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    pydantic \
    pandas \
    scikit-learn \
    xgboost \
    joblib

# Copy backend app and serialized model pipeline
COPY api.py .
COPY desalter_risk_model.pkl .

# Expose FastAPI port
EXPOSE 8000

# Launch Uvicorn server
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]
